# Copy to .env locally if you want (optional; install does not require it).
# For local single-user runserver, DEBUG=1 and a default secret are fine.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SEMR_EYE_TRACKING_MODE=0
# SEMR_REQUIRE_LOGIN=0
